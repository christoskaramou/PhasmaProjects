<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <open_pbr_surface name="surface" type="surfaceshader">
    <input name="base_color" type="color3" value="0.8, 0.8, 0.8" />
    <input name="base_metalness" type="float" value="0" />
    <input name="specular_roughness" type="float" value="0.5" />
    <input name="specular_ior" type="float" value="1.5" />
    <input name="coat_weight" type="float" value="0" />
    <input name="coat_roughness" type="float" value="0" />
    <input name="coat_ior" type="float" value="1.5" />
    <input name="coat_darkening" type="float" value="0" />
    <input name="fuzz_weight" type="float" value="0" />
    <input name="fuzz_color" type="color3" value="1, 1, 1" />
    <input name="fuzz_roughness" type="float" value="0" />
    <input name="specular_weight" type="float" value="1" />
    <input name="specular_color" type="color3" value="1, 1, 1" />
    <input name="emission_color" type="color3" value="0, 0, 0" />
    <input name="emission_luminance" type="float" value="1" />
    <input name="transmission_weight" type="float" value="0" />
    <input name="transmission_color" type="color3" value="1, 1, 1" />
    <input name="transmission_depth" type="float" value="0" />
    <input name="geometry_thin_walled" type="boolean" value="true" />
    <input name="thin_film_weight" type="float" value="0" />
    <input name="thin_film_ior" type="float" value="1.3" />
    <input name="thin_film_thickness" type="float" value="0.4" />
  </open_pbr_surface>
  <surfacematerial name="Material" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="surface" />
  </surfacematerial>
</materialx>
